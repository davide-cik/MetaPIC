{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetaPIC",
  "version": "0.2.2",
  "identifier": "it.contentisking.metapic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MetaPIC",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Content is king Srl",
    "copyright": "© 2026 Davide Giansoldati / Content is king Srl",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Convertitore di immagini nei formati moderni",
    "category": "Graphics and Design",
    "homepage": "https://github.com/davide-cik/MetaPIC"
  }
}
